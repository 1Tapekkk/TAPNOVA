<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="WindowBg" Color="#111115"/>
 <SolidColorBrush x:Key="PanelBg" Color="#19191F"/>
 <SolidColorBrush x:Key="BorderBrush" Color="#34313C"/>
 <SolidColorBrush x:Key="TextBrush" Color="#F3F1EB"/>
 <SolidColorBrush x:Key="MutedBrush" Color="#A69FAF"/>
 <SolidColorBrush x:Key="AccentBrush" Color="#C5B5F4"/>
 <SolidColorBrush x:Key="MintBrush" Color="#E9AD96"/>
 <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
  <GradientStop Color="#C4B5FD" Offset="0"/><GradientStop Color="#8B5CF6" Offset="1"/>
 </LinearGradientBrush>
 <DrawingImage x:Key="BrandMark"><DrawingImage.Drawing><DrawingGroup>
  <GeometryDrawing Brush="#C5B5F4" Geometry="M 28,0 L 100,0 Q 128,0 128,28 L 128,100 Q 128,128 100,128 L 28,128 Q 0,128 0,100 L 0,28 Q 0,0 28,0 Z"/>
  <GeometryDrawing Brush="#211B32" Geometry="M 23,32 H 79 V 48 H 59 V 96 H 42 V 48 H 23 Z"/>
  <GeometryDrawing Brush="#211B32" Geometry="M 66,56 H 81 L 94,76 V 32 H 110 V 96 H 94 L 82,77 V 96 H 66 Z"/>
  <GeometryDrawing Brush="#211B32" Geometry="M 18,105.5 H 48 V 110.5 H 18 Z"/>
 </DrawingGroup></DrawingImage.Drawing></DrawingImage>
 <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style>
 <Style TargetType="Button">
  <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  <Setter Property="Background" Value="#232129"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
  <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/>
  <Setter Property="Margin" Value="0,0,6,0"/><Setter Property="MinHeight" Value="36"/>
  <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#40364F"/><Setter TargetName="Surface" Property="BorderBrush" Value="#C5B5F4"/><Setter Property="Foreground" Value="#F3F1EB"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#65E5C4"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="#C5B5F4"/><Setter Property="BorderBrush" Value="#C5B5F4"/><Setter Property="Foreground" Value="#211B32"/>
 </Style>
 <Style TargetType="TextBox">
  <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="#111115"/>
  <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="CaretBrush" Value="{StaticResource MintBrush}"/><Setter Property="SelectionBrush" Value="#7560CB"/>
  <Setter Property="Padding" Value="12,8"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
   <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
    <ScrollViewer x:Name="PART_ContentHost"/>
   </Border>
   <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A78BFA"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
