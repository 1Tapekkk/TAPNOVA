{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tapnova-licenses",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "../public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "tapnova-licenses", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "421001", "simple": { "limit": 5, "period": 60 } },
    { "name": "ACTIVATION_LIMIT", "namespace_id": "421002", "simple": { "limit": 20, "period": 60 } },
    { "name": "CLIENT_LIMIT", "namespace_id": "421003", "simple": { "limit": 600, "period": 60 } }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": false }
}
